<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/syncing_header">

        <ListPreference
            app:defaultValue="zoteroapi"
            app:entries="@array/sync_options_entries"
            app:entryValues="@array/sync_options_values"
            app:key="sync_method"
            app:title="@string/sync_method"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="EXTERNAL_CACHE"
            app:entries="@array/attachment_storage_location_entries"
            app:entryValues="@array/attachment_storage_location_values"
            app:key="attachment_sync_location"
            app:title="@string/setting_sync_attachments_location"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreference
            android:defaultValue="true"
            android:key="attachments_uploading_enabled"
            android:title="Offer to upload attachments" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/library_header">
        <ListPreference
            app:defaultValue="TITLE"
            app:entries="@array/sort_options_entries"
            app:entryValues="@array/sort_options_values"
            app:key="sort_method"
            app:title="@string/sort_method_title"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreference
            android:defaultValue="true"
            android:key="should_live_search"
            android:summary="Turn off if your search is too slow"
            android:title="Search as you type" />
        <SwitchPreference
            android:defaultValue="true"
            android:key="show_pdf_thumbnails"
            android:summary="Show the first page of PDFs that are on this device. Takes effect when the library is reopened"
            android:title="Show PDF covers" />
        <ListPreference
            app:defaultValue="OPENED"
            app:dependency="show_pdf_thumbnails"
            app:entries="@array/cloud_pdf_covers_entries"
            app:entryValues="@array/cloud_pdf_covers_values"
            app:key="cloud_pdf_covers"
            app:title="PDF covers for cloud folders"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreference
            android:defaultValue="false"
            android:key="check_md5sum_before_attachment_open"
            android:summary="Enabling this may slow down the opening of large attachments"
            android:title="Verify attachment integrity before opening" />

    </PreferenceCategory>

    <PreferenceCategory app:title="Search inside PDFs">
        <SwitchPreference
            android:defaultValue="true"
            android:key="search_inside_pdfs"
            android:summary="Also find words inside your PDFs, using zotero.org (needs internet, and 'Sync full-text content' turned on in Zotero desktop)"
            android:title="Search inside PDFs" />
        <ListPreference
            app:defaultValue="WIFI"
            app:dependency="search_inside_pdfs"
            app:entries="@array/search_snippets_entries"
            app:entryValues="@array/search_snippets_values"
            app:key="search_snippets"
            app:title="Show text around matches"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="15"
            app:dependency="search_inside_pdfs"
            app:entries="@array/snippets_per_search_entries"
            app:entryValues="@array/snippets_per_search_values"
            app:key="snippets_per_search"
            app:summary="Download the text of up to %s per search. PDFs whose text is already saved are always included"
            app:title="Downloads per search" />
        <SwitchPreference
            android:defaultValue="false"
            android:dependency="search_inside_pdfs"
            android:key="sort_pdf_results_by_matches"
            android:summary="Most matches first. Counts come from saved text and this search's downloads; the list re-sorts once they're all in"
            android:title="Sort by number of matches" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Saved PDF text">
        <Preference
            app:key="download_all_pdf_text"
            app:summary="Saves the text of every PDF on this phone (Wi-Fi only), so every search result gets its context line and match count. Tap to start."
            app:title="Download text of all PDFs" />
        <ListPreference
            app:defaultValue="30"
            app:entries="@array/fulltext_cache_days_entries"
            app:entryValues="@array/fulltext_cache_days_values"
            app:key="fulltext_cache_days"
            app:summary="%s"
            app:title="Remove saved text not used for" />
        <ListPreference
            app:defaultValue="100"
            app:entries="@array/fulltext_cache_mb_entries"
            app:entryValues="@array/fulltext_cache_mb_values"
            app:key="fulltext_cache_mb"
            app:summary="Up to %s on this phone. When full, the text used least recently is removed first"
            app:title="Space for saved text" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Web DAV">
        <SwitchPreference
            android:defaultValue="false"
            android:enabled="true"
            app:enabled="true"
            android:key="use_webdav"
            android:title="Use webdav to access attachments" />

        <Preference
            android:enabled="true"
            android:key="configure_webdav"
            android:title="Configure Webdav" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Advanced">
        <EditTextPreference
            android:enabled="true"
            android:key="http_write_timeout"
            android:title="HTTP Upload timeout (ms)"
            android:defaultValue="60000"
            android:summary="This is the amount of time to wait for an upload to complete before timing out. Use 0 for indefinite."
            android:inputType="number" />
<!--        <Preference-->
<!--            android:enabled="true"-->
<!--            android:key="http_read_timeout"-->
<!--            android:title="HTTP Download timeout (ms)"-->
<!--            android:defaultValue="60000"-->
<!--            android:summary="This is the amount of time to wait for a download to complete before timing out. Use 0 for indefinite."-->
<!--            android:inputType="number" />-->
    </PreferenceCategory>
</PreferenceScreen>
